	<detail>
		<band height="22">
			<element kind="rectangle" mode="Opaque" x="0" y="0" width="802" height="22" backcolor="#F3F0FA">
				<printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
				<pen lineWidth="0.0"/>
			</element>
			<element kind="textField" x="0" y="0" width="70" height="22" fontSize="8.5" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
				<box leftPadding="6" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#D9D4EC"/></box>
				<expression><![CDATA[$F{IDAnggota}]]></expression>
