		</element>
	</title>
	<columnHeader height="26">
		<element kind="staticText" mode="Opaque" x="0" y="0" width="70" height="26" forecolor="#FFFFFF" backcolor="#6D28D9" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[ID Anggota]]></text>
			<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
		</element>
		<element kind="staticText" mode="Opaque" x="70" y="0" width="130" height="26" forecolor="#FFFFFF" backcolor="#6D28D9" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
