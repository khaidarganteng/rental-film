<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="anggota" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<query language="sql"><![CDATA[SELECT * FROM anggota]]></query>
	<field name="IDAnggota" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="tempat_lahir" class="java.lang.String"/>
	<field name="tgl_lahir" class="java.lang.Object"/>
	<field name="jkl" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="alamat" class="java.lang.String"/>
	<field name="telp" class="java.lang.String"/>
